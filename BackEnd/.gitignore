# Build output
bin/
obj/
out/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.user
*.suo

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# Secrets -- never commit real connection strings/credentials (ARCHITECTURE-SPINE.md AD-5 Consistency Conventions)
appsettings.*.local.json
*.pfx
.env
.env.*
!.env.example

# EF Core
*.db
*.db-shm
*.db-wal

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
.nuget/

# OS
.DS_Store
Thumbs.db

# Environment-specific TLS-inspection CA certs (see src/FlexDemy.Api/certs/README.md) --
# never commit a corporate proxy's root/intermediate CA to the shared repo.
src/FlexDemy.Api/certs/*.pem
src/FlexDemy.Api/certs/*.crt
!src/FlexDemy.Api/certs/.gitkeep
!src/FlexDemy.Api/certs/README.md
